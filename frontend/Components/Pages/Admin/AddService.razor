@page "/addservice-Admin"
@layout AdminLayout

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Thêm dịch vụ</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="serviceModel" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="serviceName" class="form-label">Tên dịch vụ</label>
                            <InputText id="serviceName" class="form-control" @bind-Value="serviceModel.Name" />
                        </div>

                        <div class="mb-3">
                            <label for="serviceDescription" class="form-label">Mô tả</label>
                            <InputTextArea id="serviceDescription" class="form-control" rows="4" @bind-Value="serviceModel.Description" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="servicePrice" class="form-label">Giá</label>
                                <InputNumber id="servicePrice" class="form-control" @bind-Value="serviceModel.Price" />
                            </div>
                            <div class="col-md-6">
                                <label for="serviceCategory" class="form-label">Loại dịch vụ</label>
                                <InputText id="serviceCategory" class="form-control" @bind-Value="serviceModel.Category" />
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Lưu dịch vụ</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ServiceModel serviceModel = new ServiceModel();

    private void HandleValidSubmit()
    {
        // Xử lý lưu dịch vụ ở đây
    }

    private class ServiceModel
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public decimal? Price { get; set; }
        public string Category { get; set; }
    }
}