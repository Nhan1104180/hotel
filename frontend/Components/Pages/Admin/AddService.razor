@page "/addservice-Admin"
@layout AdminLayout
@inject NavigationManager Navigation
@inject ServiceService _serviceService
@inject ServiceCategoryService _serviceCategory

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Thêm dịch vụ</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="serviceName" class="form-label">Tên dịch vụ</label>
                            <InputText id="serviceName" class="form-control" @bind-Value="model.Name" />
                            <ValidationMessage For="@(() => model.Name)" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="serviceCategory" class="form-label">Loại dịch vụ</label>
                                <InputSelect class="form-select" @bind-Value="model.CategoryId">
                                    <option value="0" selected disabled>Chọn loại dịch vụ</option>
                                    @foreach (var item in _serviceCategory._serviceCategory)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => model.CategoryId)" />
                            </div>

                            <div class="col-md-6">
                                <label for="servicePrice" class="form-label">Giá</label>
                                <InputNumber id="servicePrice" class="form-control" @bind-Value="model.Price" />
                                <ValidationMessage For="@(() => model.Price)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="serviceDescription" class="form-label">Mô tả</label>
                            <InputText id="serviceDescription" class="form-control" @bind-Value="model.Description" />
                            <ValidationMessage For="@(() => model.Description)" />
                        </div>

                        @if (!string.IsNullOrEmpty(Message))
                        {
                            <div class="alert alert-danger mt-4">@Message</div>
                        }

                        <div class="d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-light border">Làm lại</button>
                            <button type="submit" class="btn btn-primary">Lưu dịch vụ</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AddServiceViewModel model = new AddServiceViewModel();
    private string Message = "";

    protected override async Task OnInitializedAsync()
    {
        _serviceCategory.OnChange += StateHasChanged;
        await _serviceCategory.GetServiceCategory();
    }

    protected async Task HandleValidSubmit()
    {
        Console.WriteLine($"Name: {model.Name}");
        Console.WriteLine($"CategoryId: {model.CategoryId}");
        Console.WriteLine($"Price: {model.Price}");
        Console.WriteLine($"Description: {model.Description}");
        
        var result = await _serviceService.AddService(model);
        if (result)
        {
            Navigation.NavigateTo("/service-admin");
        }
        else
        {
            Message = _serviceService.ErrorMessage;
        }
    }

    public void Dispose()
    {
        _serviceCategory.OnChange -= StateHasChanged;
    }
}