@page "/Addcategory-Admin"
@layout AdminLayout
@inject NavigationManager Navigation
@inject ServiceCategoryService _serviceCategory

<PageTitle>Thêm phòng</PageTitle>
<div class="container py-4">
	<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
		<div>
			<h1 class="h3 mb-1">Thêm loại dịch vụ</h1>
		</div>
		<a href="/categoryservice-admin" class="btn btn-outline-secondary">
			<i class="bi bi-arrow-left me-1"></i>Quay lại
		</a>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="card-header bg-white py-3">
			<h2 class="h5 mb-0">Thông tin loại dịch vụ</h2>
		</div>
		<div class="card-body p-4">
			<EditForm Model="category" OnValidSubmit="HandleValidSubmit">
				<DataAnnotationsValidator />
				<div class="row g-3">
					<div class="col-md-6">
						<label for="roomNumber" class="form-label">Tên loại dịch vụ <span class="text-danger">*</span></label>
						<InputText @bind-Value="category.Name" id="roomNumber" type="text" class="form-control" />
						<ValidationMessage For="@(() => category.Name)" />
					</div>

					<div class="mb-3">
							<label for="description" class="form-label">Mô tả</label>
							<InputTextArea id="description" class="form-control" rows="4" @bind-Value="category.Description" />
							<ValidationMessage For="() => category.Description" />
						</div>

				</div>

				@if (!string.IsNullOrEmpty(Message))
                {
                    <div class="alert alert-danger mt-4">@Message</div>
                }

				<hr class="my-4" />
				<div class="d-flex justify-content-end gap-2">
					<button type="reset" class="btn btn-light border">Làm lại</button>
					<button type="submit" class="btn btn-primary">
						<i class="bi bi-plus-lg me-1"></i>Tạo phòng
					</button>
				</div>
			</EditForm>
		</div>
	</div>
</div>

@code {
	private AddServiceCategoryViewModel category = new AddServiceCategoryViewModel();
	private string Message = "";
	protected override async Task OnInitializedAsync()
	{
		_serviceCategory.OnChange += StateHasChanged;
		await _serviceCategory.GetServiceCategory();
	}
	
	protected async Task HandleValidSubmit()
	{
		var result = await _serviceCategory.AddCategory(category);
		if (result)
		{
			Navigation.NavigateTo("/categoryservice-admin");
		}
		else
		{
			Message = _serviceCategory.ErrorMessage;
		}
	}

	public void Dispose()
	{
		_serviceCategory.OnChange -= StateHasChanged;
	}
}