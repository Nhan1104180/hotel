@page "/service-admin"
@layout AdminLayout
@inject ServiceService _serviceService
@inject ServiceCategoryService _serviceCategoryService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-4">

    <h3 class="mb-4">Quản lý dịch vụ</h3>

    <!-- Search -->
    <div class="row mb-4">

        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text" class="form-control" placeholder="Search service..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select class="form-select">
                <option>Tất cả</option>
                @foreach (var item in _serviceCategoryService._serviceCategory)
                {
                    <option>@item.Name</option>
                }
            </select>
        </div>

        <div class="col-md-5 d-flex align-items-end justify-content-end">
            <button class="btn btn-primary" @onclick='@(() => Navigation.NavigateTo("/addservice-Admin"))'>+ Thêm dịch vụ</button>
        </div>

    </div>

    <EditForm EditContext="@editContext">
        <DataAnnotationsValidator />

        <!-- Table -->
        <table class="table table-bordered table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Hình ảnh</th>
                    <th>Tên dịch vụ</th>
                    <th>Loại</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th>Mô tả</th>
                    <th>Thời gian</th>
                    <th width="250">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in _serviceService._serviceList)
                {
                    bool isEditing = editServiceId == item.Id;
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top" style="height:20px;object-fit:cover">
                            }
                            else
                            {
                                <img src="/images/no-image.png" class="card-img-top" style="height:20px;object-fit:cover">
                            }
                        </td>

                        <td>
                            @if (isEditing)
                            {
                                <InputText class="form-control" @bind-Value="editModel.Name" />
                                <ValidationMessage For="@(() => editModel.Name)" />
                            }
                            else
                            {
                                @item.Name
                            }
                        </td>

                        <td>
                            @if (isEditing)
                            {
                                <InputSelect class="form-select" @bind-Value="editModel.CategoryId">
                                    @foreach (var category in _serviceCategoryService._serviceCategory)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => editModel.CategoryId)" />
                            }
                            else
                            {
                                @_serviceCategoryService._serviceCategory.FirstOrDefault(c => c.Id == item.CategoryId)?.Name
                            }
                        </td>

                        <td>
                            @if (isEditing)
                            {
                                <InputNumber TValue="decimal" class="form-control" @bind-Value="editModel.Price" />
                                <ValidationMessage For="@(() => editModel.Price)" />

                            }
                            else
                            {
                                @($"{item.Price:N0} Đ")
                            }
                        </td>

                        <td>
                            @if (editStatusServiceId == item.Id)
                            {
                                <InputSelect class="form-select form-select-sm" @bind-Value="editStatusId">
                                    @foreach (var status in _serviceService._serviceStatusList)
                                    {
                                        <option value="@status.Id">@status.name</option>
                                    }
                                </InputSelect>
                            }
                            else
                            {
                                <span class="badge @GetStatusBadgeClass(item.Status)">@item.Status</span>
                            }
                        </td>

                        <td>
                            @if (isEditing)
                            {
                                <InputTextArea class="form-control" style="height: 150px; width:150px;" @bind-Value="editModel.Description" />
                                <ValidationMessage For="@(() => editModel.Description)" />
                            }
                            else
                            {
                                @item.Description
                            }
                        </td>

                        <td> @item.CreatedAt.ToString("dddd, dd/MM/yyyy") </td>
                        <td>
                            @if (isEditing)@* Cập nhật thông tin dịch vụ *@
                            {
                                <button type="button" class="btn btn-success btn-sm"
                                        @onclick="() => SaveService(item.Id)">Lưu</button>
                                <button class="btn btn-secondary btn-sm mx-1" @onclick="CancelEdit">Hủy</button>
                            }
                            else if (editStatusServiceId == item.Id)
                            @* Cập nhật trạng thái dịch vụ *@
                            {
                                <button class="btn btn-success btn-sm" @onclick="() => SaveStatus(item.Id)">Lưu</button>
                                <button class="btn btn-secondary btn-sm mx-1" @onclick="CancelEditStatus">Hủy</button>
                            }
                            else
                            {
                                <button class="btn btn-warning btn-sm" @onclick="() => StartEdit(item)">Sửa</button>
                                <button class="btn btn-info btn-sm mx-1" @onclick="() => StartEditStatus(item)">Đổi trạng thái</button>
                                <button class="btn btn-danger btn-sm ms-1" @onclick="() => DeleteService(item.Id)">Xóa</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
    </EditForm>

        
        <!-- Pagination -->
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                <li class="page-item active"> <a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li>
            </ul>
        </nav>

</div>

@code
{
    private List<ServiceViewModel> Services = new List<ServiceViewModel>();
    private UpdateServiceViewModel editModel = new();
    private string Message = "";
    private int? editServiceId = null;
    private int? editStatusServiceId = null;
    private int editStatusId;
    private EditContext editContext;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(editModel);


        _serviceService.OnChange += StateHasChanged;

        _serviceCategoryService.OnChange += StateHasChanged;

        await _serviceService.GetServiceList();
        await _serviceService.GetServiceStatus();
        await _serviceCategoryService.GetServiceCategory();
    }

    //Cập nhật thông tin dịch vụ
    private void StartEdit(ServiceViewModel service)
    {
        editServiceId = service.Id;

        editModel = new UpdateServiceViewModel
        {
            Id = service.Id,
            Name = service.Name,
            Description = service.Description,
            CategoryId = service.CategoryId,
            Price = service.Price
        };

        editContext = new EditContext(editModel);
    }

    private void CancelEdit()
    {
        editServiceId = null;
    }

    //Cập nhật trạng thái dịch vụ
    private void StartEditStatus(ServiceViewModel service)
    {
        editStatusServiceId = service.Id;
        editStatusId = _serviceService._serviceStatusList.FirstOrDefault(s => s.name == service.Status)?.Id ?? 0;
        Message = "";
    }

    private void CancelEditStatus()
    {
        editStatusServiceId = null;
    }

    private async Task SaveService(int id)
    {

        if (!editContext.Validate()) return;

        var result = await _serviceService.UpdateService(id, editModel);

        if (result)
        {
            var service = _serviceService._serviceList.FirstOrDefault(r => r.Id == id);
            if (service != null)
            {
                service.Name = editModel.Name!;
                service.Description = editModel.Description!;
                service.Price = editModel.Price;
                service.CategoryId = editModel.CategoryId;
            }
            editServiceId = null;
            Services = _serviceService._serviceList.ToList();
        }
        else
        {
            Message = _serviceService.ErrorMessage;
        }
    }

    private async Task SaveStatus(int id)
    {
        try
        {
            var updatestatus = new UpdateServiceStatusViewModel
            {
                Id = id,
                Status = editStatusId
            };

            var result = await _serviceService.UpdateServiceStatus(id, updatestatus);

            if (result)
            {
                var service = _serviceService._serviceList.FirstOrDefault(r => r.Id == id);
                var status = _serviceService._serviceStatusList.FirstOrDefault(s => s.Id == editStatusId);

                if (service != null && status != null)
                {
                    service.Status = status.name;
                }

                editStatusServiceId = null;
                Services = _serviceService._serviceList.ToList();
                
                await _serviceService.GetServiceList();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "text-bg-success",
        "Inactive" => "text-bg-danger",
    };

    //Xóa
    private async Task DeleteService(int id)
    {
        bool ok = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa dịch vụ này không?");

        if (!ok)  return;

        var result = await _serviceService.DeleteService(id);

        if (result)
        {
            Services = _serviceService._serviceList.ToList();
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Message = _serviceService.ErrorMessage;
        }
    }

    private void Dispose()
    {
        _serviceService.OnChange -= StateHasChanged;
        _serviceCategoryService.OnChange -= StateHasChanged;
    }
}