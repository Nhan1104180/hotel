@page "/guest-selector"

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<h2 class="visually-hidden">Guest selector for hotel booking</h2>

<!-- Search Bar -->
<div class="bg-primary p-3 rounded-3 mb-3">
    <div class="d-flex gap-2 align-items-stretch">
        <div class="bg-white border border-warning border-2 rounded px-3 py-2 d-flex align-items-center gap-2 flex-grow-1">
            <i class="ti ti-map-pin text-primary fs-5" aria-hidden="true"></i>
            <span>Thành phố Hồ Chí Minh</span>
        </div>
        <div class="bg-white border border-warning border-2 rounded px-3 py-2 d-flex align-items-center gap-2">
            <i class="ti ti-calendar text-primary fs-5" aria-hidden="true"></i>
            <span>6 tháng 7</span>
        </div>
        <div class="bg-warning border border-warning border-2 rounded px-3 py-2 d-flex align-items-center gap-2 flex-grow-1"
             style="cursor:pointer" @onclick="ToggleDropdown">
            <i class="ti ti-user fs-5" aria-hidden="true"></i>
            <span class="me-auto">@SummaryText</span>
            <i class="ti ti-chevron-down" aria-hidden="true"></i>
        </div>
        <button class="btn btn-info text-white fw-medium px-4">Tìm kiếm</button>
    </div>
</div>

<!-- Dropdown -->
@if (IsDropdownOpen)
{
    <div class="bg-white rounded-3 shadow p-4" style="max-width:340px">

        <!-- Người lớn -->
        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
            <span class="fs-6">Người lớn</span>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center p-0"
                        style="width:32px;height:32px;font-size:20px"
                        @onclick="() => Change(ref _adults, -1, 1)"
                        disabled="@(_adults <= 1)"
                        aria-label="Giảm người lớn">−</button>
                <span class="fs-6 fw-medium" style="min-width:20px;text-align:center">@_adults</span>
                <button class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center p-0"
                        style="width:32px;height:32px;font-size:20px"
                        @onclick="() => Change(ref _adults, 1, 1)"
                        aria-label="Tăng người lớn">+</button>
            </div>
        </div>

        <!-- Trẻ em -->
        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
            <span class="fs-6">Trẻ em</span>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center p-0"
                        style="width:32px;height:32px;font-size:20px"
                        @onclick="() => Change(ref _children, -1, 0)"
                        disabled="@(_children <= 0)"
                        aria-label="Giảm trẻ em">−</button>
                <span class="fs-6 fw-medium" style="min-width:20px;text-align:center">@_children</span>
                <button class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center p-0"
                        style="width:32px;height:32px;font-size:20px"
                        @onclick="() => Change(ref _children, 1, 0)"
                        aria-label="Tăng trẻ em">+</button>
            </div>
        </div>

        <!-- Phòng -->
        <div class="d-flex justify-content-between align-items-center py-3">
            <span class="fs-6">Phòng</span>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center p-0"
                        style="width:32px;height:32px;font-size:20px"
                        @onclick="() => Change(ref _rooms, -1, 1)"
                        disabled="@(_rooms <= 1)"
                        aria-label="Giảm phòng">−</button>
                <span class="fs-6 fw-medium" style="min-width:20px;text-align:center">@_rooms</span>
                <button class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center p-0"
                        style="width:32px;height:32px;font-size:20px"
                        @onclick="() => Change(ref _rooms, 1, 1)"
                        aria-label="Tăng phòng">+</button>
            </div>
        </div>

        <!-- Pet toggle -->
        <div class="d-flex justify-content-between align-items-center py-3 border-top">
            <span class="fs-6">Mang thú cưng đi cùng</span>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch"
                       style="width:44px;height:24px;cursor:pointer"
                       @bind="_bringPet" />
            </div>
        </div>

        <p class="text-muted small mb-3">
            Động vật trợ giúp không được xem là vật nuôi.
            <a href="#" class="text-primary">Đọc thêm về chủ đề đi du lịch cùng động vật trợ giúp</a>
        </p>

        <button class="btn btn-outline-primary w-100 fw-medium" @onclick="ToggleDropdown">Xong</button>
    </div>
}

@code {
    private int _adults = 3;
    private int _children = 0;
    private int _rooms = 1;
    private bool _bringPet = true;
    private bool IsDropdownOpen = false;

    private string SummaryText =>
        $"{_adults} người lớn · {_children} trẻ em · {_rooms} phòng";

    private void Change(ref int field, int delta, int min)
    {
        field = Math.Max(min, field + delta);
    }

    private void ToggleDropdown()
    {
        IsDropdownOpen = !IsDropdownOpen;
    }
}
