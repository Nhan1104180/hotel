@page "/"
@layout MainLayout

<PageTitle>Home</PageTitle>

<section class="room">
    <div class="container py-5">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold">Phòng</h3>
            </div>

            <a href="/rooms" class="text-danger text-decoration-none fw-semibold">Xem tất cả ></a>
        </div>

        <!-- Card list -->
        <RoomCard />
    </div>
</section>

<section class="service">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold">Dịch vụ tiện ích</h3>
            </div>

            <a href="/service" class="text-danger text-decoration-none fw-semibold">Xem tất cả ></a>
        </div>

        <ServiceCard />
    </div>
</section>

<section class="reviews">
    <div class="container py-5 ">

        <!-- Title -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mb-0">Bài đánh giá</h3>
            <a href="#" class="text-decoration-none">Xem thêm →</a>
        </div>

        <div class="row g-3">
            @for (int i = 1; i <= 4; i++)
            {
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-warning mb-3"> ★★★★★</div>

                            <p class="card-text">Phòng sạch sẽ, nhân viên rất nhiệt tình. Vị trí ngay trung tâm phố cổ, đi bộ 5 phút là tới Chùa Cầu. Sẽ quay lại lần sau! </p>

                            <div class="d-flex align-items-center mt-4">
                                <div class="rounded-circle bg-light text-dark fw-bold d-flex justify-content-center align-items-center" style="width:40px;height:40px;">NA</div>

                                <div class="ms-3">
                                    <div class="fw-semibold">Nguyễn Văn An</div>
                                    <small class="text-secondary">Tháng 5, 2026</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>