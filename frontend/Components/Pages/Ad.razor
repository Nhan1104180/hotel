@page "/guest"

<div class="position-relative">

    <!-- Ô hiển thị -->
    <div class="bg-white p-3 rounded-3"
         style="width:220px;cursor:pointer"
         @onclick="ToggleDropdown">

        <div class="bg-warning rounded px-3 py-3 text-center">
            @SummaryText
        </div>
    </div>

    @if (IsDropdownOpen)
    {
        <div class="position-absolute bg-white rounded-3 shadow p-4"
             style="top:100%; left:0; width:300px; z-index:1000;">

            <!-- Người lớn -->
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">

                <span>Người lớn</span>

                <div class="d-flex align-items-center gap-3">

                    <button class="btn btn-outline-primary rounded-circle"
                            style="width:40px;height:40px"
                            @onclick="() => Change(ref Adults,-1,1)"
                            disabled="@(Adults<=1)">
                        -
                    </button>

                    <span>@Adults</span>

                    <button class="btn btn-outline-primary rounded-circle"
                            style="width:40px;height:40px"
                            @onclick="() => Change(ref Adults,1,1)">
                        +
                    </button>

                </div>

            </div>

            <button class="btn btn-outline-primary w-100 mt-4"
                    @onclick="ToggleDropdown">
                Xong
            </button>

        </div>
    }

</div>

@code {
    private int Adults = 1;
    private bool IsDropdownOpen = false;

    private string SummaryText =>
        $"{Adults} người lớn ";

    private void Change(ref int field, int delta, int min)
    {
        field = Math.Max(min, field + delta);
    }

    private void ToggleDropdown()
    {
        IsDropdownOpen = !IsDropdownOpen;
    }
}

