@inject ServiceService _serviceService
@inject ServiceCategoryService _serviceCategoryService
@inject NavigationManager Navigation

@if (_serviceCategoryService._serviceCategory.Count == 0)
{
    <div class="col-12">
        <div class="alert alert-info text-center" role="alert">
            <i class="fas fa-info-circle"></i> Không có dịch vụ
        </div>
    </div>
}
else
{
    <div class="row gap-3">
        @foreach (var item in _serviceCategoryService._serviceCategory)
        {
            <div class="col mt-5">
                <div class="card h-100" style="width: 18rem;" @onclick="@(() => Navigation.NavigateTo($"/service/{item.Id}"))">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" style="height:220px;object-fit:cover">
                    }
                    else
                    {
                        <img src="/images/no-image.png" class="card-img-top" style="height:220px;object-fit:cover">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        _serviceCategoryService.OnChange += StateHasChanged;
        await _serviceCategoryService.GetServiceCategory();
    }

    public void Dispose()
    {
        _serviceCategoryService.OnChange -= StateHasChanged;
    }
}